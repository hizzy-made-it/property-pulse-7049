{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.propertypulse_k7x2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1d2d3d"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://propert-0on0pqt-preview-4200.runable.site/",
      "applicationId": "propert-0on0pqt",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.propertypulse_k7x2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#f2f2f3"
    },
    "name": "PropertyPulse",
    "slug": "property-pulse",
    "version": "1.0.0",
    "scheme": "runable-propert-0on0pqt",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
